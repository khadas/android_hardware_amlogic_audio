package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_library_shared {

    name: "libamlspeed",

    proprietary: true,
    srcs: [
        "aml_audio_speed_manager.c",
        "audio_sonic_speed_api.c",
        "sonic_speed_wrapper.c",
    ],

    export_include_dirs: ["include"],

    header_libs: [
        "libaudio_system_headers",
        "libamaudioutils_headers",
    ],

    arch: {
        x86: {
            enabled: false,
        },
        x86_64: {
            enabled: false,
        },
    },

    shared_libs: [
        "libcutils",
        "liblog",
        "libutils",
        "libamaudioutils",
        "libsonic_ext",
    ],
}
